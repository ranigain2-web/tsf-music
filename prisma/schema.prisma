// TSF Music — Prisma schema (SQLite)

generator client {
  provider = "prisma-client-js"
  // darwin + darwin-arm64: the macOS app bundle is built on GitHub Actions and
  // must carry query engines for BOTH Intel and Apple Silicon Macs regardless
  // of which runner arch produced the build.
  binaryTargets = ["native", "darwin", "darwin-arm64"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---- Catalog cache (from InnerTube) ----

model Track {
  id          String   @id // videoId
  title       String
  artistId    String?
  artistName  String
  albumId     String?
  albumName   String?
  duration    Int      @default(0) // seconds
  thumbnail   String? // highest-res ytimg URL
  bitrate     Int      @default(0)
  year        Int?
  isExplicit  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  artist      Artist?       @relation("TrackArtist", fields: [artistId], references: [id])
  album       Album?        @relation("AlbumTracks", fields: [albumId], references: [id])
  likes         Like[]        @relation("TrackLikes")
  history       HistoryItem[] @relation("TrackHistory")
  playlistTracks PlaylistTrack[]
  aiSeeds       AiSeedTrack[]
}

model Artist {
  id          String   @id // browseId
  name        String
  thumbnail   String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tracks      Track[]       @relation("TrackArtist")
  albums      Album[]       @relation("AlbumArtist")
}

model Album {
  id          String   @id // browseId
  name        String
  artistId    String?
  artistName  String?
  year        Int?
  thumbnail   String?
  trackCount  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  artist      Artist? @relation("AlbumArtist", fields: [artistId], references: [id])
  tracks      Track[] @relation("AlbumTracks")
}

// ---- User data (single user, no auth) ----

model Like {
  id        String   @id @default(cuid())
  trackId   String
  createdAt DateTime @default(now())

  track Track @relation("TrackLikes", fields: [trackId], references: [id], onDelete: Cascade)

  @@unique([trackId])
}

model HistoryItem {
  id        String   @id @default(cuid())
  trackId   String
  playedAt  DateTime @default(now())
  msPlayed  Int      @default(0)

  track Track @relation("TrackHistory", fields: [trackId], references: [id], onDelete: Cascade)

  @@index([playedAt])
}

model Playlist {
  id        String   @id @default(cuid())
  name      String
  description String?
  coverUrl  String?
  source    String   @default("manual") // manual | ai | radio
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tracks    PlaylistTrack[]
  aiSeeds   AiPlaylist[]
}

model PlaylistTrack {
  id         String   @id @default(cuid())
  playlistId String
  trackId    String
  position   Int
  addedAt    DateTime @default(now())

  playlist Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  track    Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@unique([playlistId, trackId])
  @@index([playlistId, position])
}

model Setting {
  key   String @id
  value String
}

// ---- Cache ----

model ApiCache {
  key        String   @id
  payload    String
  expiresAt  DateTime

  @@index([expiresAt])
}

model StreamCache {
  videoId   String   @id // bare videoId, or "videoId::titleHash" for title-bound providers
  url       String
  provider  String
  expiresAt DateTime
  bitrate   Int      @default(0)
  artUrl    String?

  @@index([expiresAt])
}

model ProviderHealth {
  provider   String   @id
  ok         Boolean  @default(false)
  lastCheck  DateTime @default(now())
  lastError  String?
  latencyMs  Int      @default(0)
}

// Relay registry (Piped/Invidious instances) — populated by discovery in
// deployments that include instances.ts; read opportunistically by /api/health.
model RelayInstance {
  id        String   @id
  kind      String // piped | invidious
  baseUrl   String
  ok        Boolean  @default(false)
  latencyMs Int      @default(0)
  lastCheck DateTime @default(now())
  lastError String?
  seed      Boolean  @default(false)
}

// ---- AI (Phase 2) ----

model AiPlaylist {
  id          String   @id @default(cuid())
  prompt      String
  playlistId  String?
  model       String?
  createdAt   DateTime @default(now())

  playlist Playlist? @relation(fields: [playlistId], references: [id])
  seeds    AiSeedTrack[]
}

model AiSeedTrack {
  id          String @id @default(cuid())
  aiPlaylistId String
  trackId     String
  reason      String?

  aiPlaylist AiPlaylist @relation(fields: [aiPlaylistId], references: [id], onDelete: Cascade)
  track      Track      @relation(fields: [trackId], references: [id], onDelete: Cascade)
}

// ---- MINDBEAT v2.0 — L1 Event Ledger (append-only, 90d retention) ----

model LedgerEvent {
  id        String   @id // ULID
  ts        DateTime
  type      String   // EventType (SESSION_START | TRACK_START | TRACK_HEARTBEAT | TRACK_SKIP | ...)
  sessionId String
  trackId   String?
  surface   String?  // SourceSurface enum value
  payload   String   // JSON — event-specific fields

  @@index([ts])
  @@index([sessionId])
  @@index([type])
}

model ListenSession {
  id            String    @id
  startTs       DateTime
  endTs         DateTime?
  daypart       String    // morning | afternoon | evening | night | lateNight
  dayKind       String    // weekday | weekend
  trackCount    Int       @default(0)
  totalListenMs Int       @default(0)
}

// ---- MINDBEAT v2.0 — L2 Taste Profile (rebuildable cache over the ledger) ----

// Single-row JSON cache; the ledger is the source of truth, this is the
// compiled profile the Decision Engine reads. Rebuildable <3s.
model TasteProfileRow {
  id        String   @id @default("main")
  data      String
  updatedAt DateTime @updatedAt
}

// ---- MINDBEAT v2.0 — Proxy Feature Space ("Sonic Signal Synthesis") ----
// LLM cultural priors (cached forever) + behavioral calibration deltas.

model TrackFeature {
  trackId     String  @id
  energy      Float?
  valence     Float?
  tempoClass  String? // slow | mid | fast
  acoustic    String? // acoustic | amplified | electronic
  eraBucket   String? // pre-80s | 80s | 90s | 2000s | 2010s | current
  language    String?
  moodTags    String? // JSON array
  confidence  String? // HIGH | MEDIUM | LOW
  effEnergy   Float?  // behaviorally calibrated effective energy
  effValence  Float?
  calibrations Int    @default(0)
  updatedAt   DateTime @updatedAt
}
