# TSF Music server environment template.
# Copy to .env and adjust — the app runs with sane defaults on a laptop.

# SQLite database location. Relative to prisma/schema.prisma, so the repo is
# portable across machines. `bun run dev` creates + migrates it automatically.
DATABASE_URL=file:../db/custom.db

# ─────────────────────────────────────────────────────────────────────────────
# Optional: AI provider credentials file (.z-ai-config) enables the fast
# zai/glm provider chain for AI playlists. Without it, TSF falls back to the
# slow-but-free zen provider automatically. See src/lib/ai/engine.ts.
# ─────────────────────────────────────────────────────────────────────────────
